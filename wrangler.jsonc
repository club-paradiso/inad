{
  // Cloudflare Workers + static assets. Deploy: `npm run build && npx wrangler deploy`
  // (or connect the repo in Workers & Pages → Builds with build command `npm run build`, deploy command `npx wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inad",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API goes through the Worker; everything else is a static asset (headers from dist/_headers).
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
  // Secrets (never commit): `npx wrangler secret put DATA_GO_KR_SERVICE_KEY`; NPC provider variables only if the
  // optional inference layer is wanted (see api/_npc/config.js). Without them both endpoints use their deterministic fallbacks.
}
